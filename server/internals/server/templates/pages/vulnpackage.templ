package pages

import (
	"fmt"
	"server/internals"
	"server/internals/server/templates/layouts"
)

// RenderVulnPackages wraps the whole page layout on initial load
templ RenderVulnPackages(vulnPackages []internals.VulnPackage, machineID string, nextOffset int) {
	@layouts.MainFrame("Vulnerabilities", VulnPackagePageSection(vulnPackages, machineID, nextOffset))
} 
 
// VulnPackagePageContainer builds the alert box and iterates through items
templ VulnPackagePageSection(vulnPackages []internals.VulnPackage, machineID string, nextOffset int) {
	
	 <section class="p-6">
                <!-- Page header -->
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <p class="text-sm text-base-content/60">
                            MACHINE
                        </p>

                        <h1 class="text-2xl font-bold">
                            {machineID}
                        </h1>
                    </div>

                    <div class="badge badge-outline">
                        Number Of Vulns
                    </div>
                </div>
                <!-- Search -->
                <div class="mb-6">
                    <input
                            type="search"
                            placeholder="Search CVE, package, severity..."
                            class="input input-bordered w-full"
                    />
                </div>
                <!-- Vulnerability list -->
        <div id="vuln-list-contents" class="w-full space-y-4">
			@VulnListRows(vulnPackages, machineID, nextOffset)
		</div>
		 <!-- Vulnerability list -->
        </section>
}


// VulnListRows isolated for HTMX infinite scrolling / pagination appending
templ VulnListRows(vulnPackages []internals.VulnPackage, machineID string, nextOffset int) {
	for _, pkg := range vulnPackages {
		@VulnPackageCard(pkg)
	}

	if nextOffset > 0 {
		<div id="load-more-container" class="w-full flex justify-center pt-2">
			<button
				hx-get={ string(templ.URL(fmt.Sprintf("/machines/%s/vulns?offset=%d", machineID, nextOffset))) }
				hx-target="#load-more-container"
				hx-swap="outerHTML"
				class="btn btn-sm btn-outline btn-primary"
			>
				Load More Packages
			</button>
		</div>
	}
}

templ VulnPackageCard(vulnPackage internals.VulnPackage) {
	<!-- Vulnerability -->
                    <article class="card bg-base-200 border border-base-300">
                        <div class="card-body p-4">
                            <!-- Top -->
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="font-mono font-bold">
                                        {vulnPackage.CveId}
                                    </p>

                                    <p class="text-sm text-base-content/60">
                                        {vulnPackage.PackageName}
                                    </p>
                                </div>
                                <div class="text-right">
                                    <div class="badge badge-error">
									  <!-- Severity  -->
                                        HIGH
                                    </div>

                                    <p class="text-sm mt-1">
									 <!-- CVSS SCORE  -->
                                        CVSS 3: <strong>UNKNOWN</strong>
                                    </p>
                                </div>
                            </div>

                            <!-- Version information -->
                            <div class="grid grid-cols-2 gap-4 mt-4">
                                <div>
                                    <p class="text-xs uppercase text-base-content/50">
                                        Introduced
                                    </p>
                                    <p class="font-mono">
                                        {vulnPackage.Introduced}
                                    </p>
                                </div>
                                <div>
                                    <p class="text-xs uppercase text-base-content/50">
                                        Fixed
                                    </p>
                                    <p class="font-mono">
                                       { vulnPackage.Fixed}
                                    </p>
                                </div>
                            </div>
                            <!-- CVSS -->
                            <div class="flex gap-6 mt-4 text-sm">
                                <div>
                        <span class="text-base-content/50">
                            CVSS 2
                        </span>
                                    <strong>
                                        7.5
                                    </strong>
                                </div>
                                <div>
                        <span class="text-base-content/50">
                            CVSS 3
                        </span>
                                    <strong>
                                        8.1
                                    </strong>
                                </div>
                            </div>
                        </div>
                    </article>
}