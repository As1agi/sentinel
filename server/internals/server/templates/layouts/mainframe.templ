package layouts
  
import "server/internals/server/templates/components"

templ MainFrame(current string , content templ.Component){
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>Sentinel UI</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <main class="drawer lg:drawer-open">
        <input id="my-drawer-4" type="checkbox" class="drawer-toggle inline" />
        <div class="drawer-content">
            <!-- NAVBAR TEMPLATE -->
			@components.Navbar(current)
            <!-- NAVBAR TEMPLATE -->

            <!-- Page content TEMPLATE -->
            <div id="main" class="p-4">@content</div>
            <!-- Page content TEMPLATE -->
        </div>

        <!-- SIDE-BAR TEMPLATE --> 
		@components.SideBar()
        <!-- SIDE-BAR TEMPLATE -->
    </main>
</body>
</html>
}